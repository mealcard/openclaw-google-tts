{
  "name": "google-tts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenClaw plugin for Gemini and Google Cloud TTS with Telegram auto voice replies",
  "main": "index.ts",
  "openclaw": {
    "extensions": ["./index.ts"]
  },
  "files": [
    "index.ts",
    "openclaw.plugin.json",
    "src",
    "README.md",
    "README.zh-CN.md",
    "package.json",
    "voice-config.example.json"
  ],
  "scripts": {
    "oauth-setup": "node ./src/oauth-setup.mjs",
    "test:say": "node ./src/test-say.mjs"
  },
  "dependencies": {
    "openclaw": "^2026.3.2"
  }
}
